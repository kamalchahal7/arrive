# Caddy gets and renews HTTPS certificates automatically for {$DOMAIN}.
# With DOMAIN=localhost it uses a local self-signed certificate (your browser will warn once).

# www.<domain> always sends visitors to the bare domain, permanently (301), keeping the path and query.
# Needs a DNS record for www too, so Caddy can get its certificate.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
