# Frontend env file. Copy to frontend/.env and fill in. Never commit frontend/.env.
# NEXT_PUBLIC_* values are baked in at build time (passed as Docker build args in docker-compose.yml).

NEXT_PUBLIC_API_BASE_URL=     # /api in production behind Caddy; http://localhost:8000/api in local dev
AUTH0_DOMAIN=                 # Auth0 tenant domain, e.g. your-tenant.us.auth0.com
AUTH0_CLIENT_ID=              # Auth0 Regular Web Application client id
AUTH0_CLIENT_SECRET=          # Auth0 Regular Web Application client secret
AUTH0_SECRET=                 # 32-byte hex string for session encryption: openssl rand -hex 32
APP_BASE_URL=                 # public URL of the app, e.g. http://localhost:3000
AUTH0_AUDIENCE=               # Auth0 API identifier (same as backend AUTH0_AUDIENCE)
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=   # ElevenLabs agent id for web voice
API_INTERNAL_URL=             # server-side URL of the backend API: http://backend:8000/api in Docker, http://localhost:8000/api locally
