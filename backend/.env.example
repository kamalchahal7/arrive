# Backend env file. Copy to backend/.env and fill in. Never commit backend/.env.

DATABASE_URL=                 # Tiger Cloud connection string (sslmode=require)
GEMINI_API_KEY=               # Google AI Studio API key
GEMINI_MODEL_FAST=            # current Gemini Flash model name, check docs
GEMINI_MODEL_VISION=          # model used for letter photos (can equal FAST)
GEMINI_EMBEDDING_MODEL=       # current Gemini embedding model name
EMBEDDING_DIM=768             # keep <= 2000 so a pgvector HNSW index works
ELEVENLABS_API_KEY=           # ElevenLabs API key
ELEVENLABS_AGENT_ID=          # ElevenLabs conversational agent id
ELEVENLABS_TTS_MODEL=         # multilingual TTS model, check docs
ELEVENLABS_VOICE_ID_DEFAULT=  # default voice for read-aloud
VOICE_TOOL_SECRET=            # shared secret header for ElevenLabs tool webhooks (long random string)
AUTH0_DOMAIN=                 # Auth0 tenant domain, e.g. your-tenant.us.auth0.com
AUTH0_AUDIENCE=               # API identifier created in Auth0
AUTH0_ROLES_CLAIM=https://arrive.app/roles   # namespaced claim added by the Auth0 Action
CORS_ORIGINS=http://localhost:3000           # comma-separated list of allowed origins
PUBLIC_BASE_URL=              # public URL of the app, e.g. https://arrive.example
INSIGHTS_MIN_GROUP_SIZE=5     # groups smaller than this are shown as "<5"
REQUEST_LOG_RETENTION_DAYS=365  # retention policy on request_log
TWILIO_ACCOUNT_SID=           # optional, reminders only
TWILIO_AUTH_TOKEN=            # optional, reminders only
TWILIO_FROM_NUMBER=           # optional, reminders only
